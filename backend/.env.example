# Copy to backend/.env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_DATABASE=neo4j
FLASK_DEBUG=1
PORT=5001
# Signs session cookies. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
